# apps/console environment (S01d). Set these on the console's own Vercel
# project; do NOT copy the whole apps/web env. The console receives only what
# its own code paths need (least privilege).

# Same Supabase project as apps/web (koiplnmbgnqnbywhpjlf). Sessions are
# host-only cookies, so the console and the main app never share a login.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Origin of the main app's `app.` host, no trailing slash. Used only to point a
# non-staff sign-in back to where it belongs and to build the "forgot password"
# link. Leave unset locally to omit both links.
WEB_APP_URL=https://app.tarragonhealth.ng

# Optional distributed rate limiting for sign-in and MFA attempts. Without
# these the limiter falls back to an in-process window (real, but per instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Deliberately NOT set here: SUPABASE_SERVICE_ROLE_KEY. No extracted area needs
# it yet. Add it only in the same change that moves an area which does, and say
# why in that PR.
