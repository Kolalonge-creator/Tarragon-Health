# Tarragon Health — environment variable catalogue (ARCHITECTURE.md §14).
# Copy to .env.local and fill in. Only NEXT_PUBLIC_* vars reach the browser.
# Never commit real secrets. X-Service-Key must never appear in git history.

# --- Marketing site (apps/web) ---
# Public marketing origin, no trailing slash. Powers metadataBase, canonical
# URLs, sitemap.xml, robots.txt, and OpenGraph tags. Defaults to
# https://tarragonhealth.ng when unset (see src/lib/marketing/site.ts).
NEXT_PUBLIC_SITE_URL=https://tarragonhealth.ng

# --- Marketing site: Google Maps (apps/web) ---
# Powers the contracted-partner map on /coverage (home_visit_providers +
# logistics_partners only — never public.facilities). Also used by the admin
# "Geocode" button on the Home visit / delivery partners settings page.
# Needs Maps JavaScript API + Geocoding API enabled in Google Cloud Console,
# with HTTP referrer restrictions covering the marketing domain, the app.
# subdomain, and localhost for dev. NEXT_PUBLIC_* reaches the browser by
# design — restrict by referrer, not by secrecy. Without this set, the page
# still renders — a plain text fallback instead of the interactive map, no
# broken iframe, no console error spam.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Platform deep links (supabase/functions/send-pending-notifications) ---
# The `app.` subdomain, no trailing slash — distinct from NEXT_PUBLIC_SITE_URL
# above (that's the marketing root domain). Used to build real links inside
# reminder SMS/push bodies (e.g. straight to /patient/quick-log/glucose)
# instead of a bare "open the app". Must be set on BOTH this file (local dev)
# AND the send-pending-notifications Edge Function's own secrets store — see
# that function's own comment for why they don't share a source. Defaults to
# https://app.tarragonhealth.ng when unset.
APP_BASE_URL=https://app.tarragonhealth.ng

# --- Supabase (eu-west-1; no Africa region available, NDPR residency gap accepted) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Trusted server / Edge Function contexts only — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Python ML microservice (services/ml) ---
# TypeScript -> ML over HTTP only, 5s timeout, graceful fallback.
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_KEY=

# --- Mobile app (apps/mobile) — same Supabase project, EXPO_PUBLIC_* is the
# Expo equivalent of NEXT_PUBLIC_* (bundled client-side, no secrets here).
# Belongs in apps/mobile/.env.local, not the root — listed here for the
# single environment-variable catalogue per ARCHITECTURE.md §14.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# apps/web deployment URL — the mobile app POSTs decoded BLE device
# readings to its /api/mobile/device-readings route (bearer-token
# authenticated, no cookie session available on mobile).
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# Live platform origin the mobile app's Home tab renders in a WebView
# (apps/mobile/src/screens/platform-screen.tsx). Defaults to the production
# Vercel deployment when unset.
EXPO_PUBLIC_PLATFORM_URL=https://tarragon-health-web.vercel.app

# --- Upstash Redis (cache / queues / WhatsApp conversation state) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Web Push (default notification channel, 2026-07-30) ---
# VAPID keypair (RFC 8292) — a self-signed application identity, not a
# third-party account credential, so unlike WHATSAPP_*/TERMII_API_KEY/
# RESEND_API_KEY below there is no provider account to sign up for. Required
# as Edge Function secrets on send-pending-notifications (VAPID_PUBLIC_KEY/
# VAPID_PRIVATE_KEY/VAPID_SUBJECT); NEXT_PUBLIC_VAPID_PUBLIC_KEY is the same
# public key, read client-side by PushManager.subscribe (falls back to the
# key generated for this build if unset — see
# apps/web/src/lib/push/vapid-public-key.ts).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- WhatsApp Cloud API (fallback channel, 2026-07-30 — push is default) ---
# Also required as Edge Function secrets (`supabase functions secrets set` or
# the dashboard) — supabase/functions/send-pending-notifications reads these
# from the isolated Deno runtime, not from this file / .env.local.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
# App Dashboard > Settings > Basic > App Secret. Optional but recommended —
# whatsapp-webhook validates inbound POSTs against this via
# X-Hub-Signature-256; without it, signature checking is skipped (logged to
# audit_log each time, never a crash).
WHATSAPP_APP_SECRET=

# --- Termii SMS (fallback channel) ---
# Also required as an Edge Function secret, same as WHATSAPP_* above.
TERMII_API_KEY=

# --- Resend (transactional email channel) ---
# Powers the `email` notification channel in send-pending-notifications
# (order confirmations to patients + no-login pharmacy alerts, plus future
# adherence/review reminders). Also required as an Edge Function secret, same
# as WHATSAPP_*/TERMII_API_KEY above — the Deno runtime does not read this file.
# Degrades gracefully: without RESEND_API_KEY, email rows fail with a clear
# last_error and other channels are unaffected.
RESEND_API_KEY=
# Verified sender in the Resend account. Defaults to
# "Tarragon Health <notifications@tarragonhealth.com>" if unset.
RESEND_FROM=

# --- Payments: Paystack (NGN) ---
# NGN/Paystack only this pass (Sprint 6) — Stripe/GBP diaspora billing is a
# follow-up. PAYSTACK_SECRET_KEY is used server-side only
# (apps/web/src/lib/paystack/) — hosted-checkout redirect flow keeps card
# data off our servers, no NEXT_PUBLIC_ key needed.
PAYSTACK_SECRET_KEY=
# Also required as an Edge Function secret (`supabase functions secrets set
# PAYSTACK_WEBHOOK_SECRET=... PAYSTACK_SECRET_KEY=...`) — the isolated Deno
# runtime running supabase/functions/paystack-webhook doesn't read this
# file. Register the webhook URL in the Paystack dashboard (Settings > API
# Keys & Webhooks) as:
#   https://koiplnmbgnqnbywhpjlf.supabase.co/functions/v1/paystack-webhook
PAYSTACK_WEBHOOK_SECRET=

# --- Payments: Stripe (GBP/USD diaspora) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Video consultations: Zoom (pre-referral triage + telemedicine-first
# specialist consults, docs/Tarragon_Health_Master_Operating_Plan_v4.md §7) ---
# Server-to-Server OAuth (Zoom's current recommendation for a backend that
# creates meetings with no interactive user consent — the older JWT app
# type is deprecated). apps/web/src/lib/zoom/client.ts degrades gracefully
# (isZoomConfigured() returns false) when unset.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Also required as an Edge Function secret (`supabase functions secrets set
# ZOOM_WEBHOOK_SECRET_TOKEN=...`) — the isolated Deno runtime running
# supabase/functions/zoom-webhook doesn't read this file. This is the exact
# gotcha the Stripe webhook hit (2026-07-15 sprint log): a secret set only
# in .env.local silently no-ops the deployed webhook, still returning
# HTTP 200, so Zoom never retries and the failure is invisible until
# specifically checked. Register the webhook URL in the Zoom App
# Marketplace (Feature > Event Subscriptions) as:
#   https://koiplnmbgnqnbywhpjlf.supabase.co/functions/v1/zoom-webhook
ZOOM_WEBHOOK_SECRET_TOKEN=

# --- Masked/proxy calling: Twilio Proxy (M8: patient <-> clinician/care
# coordinator calls where neither side ever sees the other's real phone
# number, founder-approved vendor 2026-07-30) ---
# apps/web/src/lib/twilio/proxy-client.ts degrades gracefully
# (isTwilioProxyConfigured() returns false) when unset — the request/close
# DB layer works today regardless; only the actual vendor call needs these.
# TWILIO_PROXY_SERVICE_SID is created once in the Twilio Console (Proxy >
# Services) and must have at least one phone number in its pool.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PROXY_SERVICE_SID=

# --- Scheduled jobs: Vercel Cron (apps/web/vercel.json) ---
# When set as a Vercel project env var, Vercel automatically attaches
# `Authorization: Bearer <CRON_SECRET>` to cron-triggered requests; routes
# under app/api/cron/* verify it themselves (e.g.
# generate-quarterly-reports/route.ts) since Vercel Cron has no other
# built-in auth. Unset locally is fine — the route just 401s, which is
# correct (nothing should be triggering it outside a real cron schedule).
CRON_SECRET=

# --- Consumer wearable cloud sync ---
# The connect/callback/webhook/pull path is built end to end and stays
# completely inert until a provider's credentials are set here: every module
# degrades gracefully (never throws) when they are unset. Apple Health has no
# cloud OAuth API at all — it's a mobile HealthKit bridge, not a server-side
# credential, so it has no entry here. Libre (Abbott) also has no entry —
# unlike the others, it has no self-serve OAuth developer program at all;
# real access needs a direct partnership with Abbott, not a client ID/secret.
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
DEXCOM_CLIENT_ID=
DEXCOM_CLIENT_SECRET=

# --- Wearable webhook authentication ---
# Fitbit and WHOOP sign their webhook bodies with the app's client secret
# above (verified HMAC-SHA1 and HMAC-SHA256 respectively), so they need
# nothing extra here.
#
# Garmin signs nothing at all, so the callback URL registered with it must
# carry a shared secret this platform checks (?secret=... on the registered
# URL, or an x-tarragon-webhook-secret header).
#
# Oura is handled both ways: if it sends an x-oura-signature header that is
# verified against OURA_CLIENT_SECRET, otherwise the shared secret below is
# required. Set OURA_WEBHOOK_SECRET regardless — it costs nothing and is the
# only protection if Oura turns out not to sign. Once a real subscription
# shows which it does, drop the dead branch in webhook-auth.ts.
#
# Treat these as credentials — rotate if a registered URL is ever exposed. A
# provider whose secret is unset cannot be verified and its webhook is
# rejected rather than trusted.
OURA_WEBHOOK_SECRET=
GARMIN_WEBHOOK_SECRET=

# Subscription-registration handshakes. Fitbit and Oura both refuse to create
# a subscription until the endpoint answers a GET challenge, so these are set
# during setup, not after. FITBIT_WEBHOOK_VERIFICATION_CODE is the code shown
# in the Fitbit developer portal when adding a subscriber;
# OURA_WEBHOOK_VERIFICATION_TOKEN is the token chosen when creating the Oura
# subscription.
FITBIT_WEBHOOK_VERIFICATION_CODE=
OURA_WEBHOOK_VERIFICATION_TOKEN=

# --- AI orchestration: Claude / LangGraph.js ---
# Also powers meal-photo nutrition estimates (lib/nutrition/meal-vision.ts).
# Unset -> the AI Coach and meal-photo estimates degrade gracefully (a meal
# still logs, just with no automatic estimate).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Cost control: max AI Coach messages per patient per Africa/Lagos day.
AI_COACH_DAILY_MESSAGE_LIMIT=20

# Voyage AI embeddings — the AI Coach's reference-content retrieval only
# (lib/lifestyle/voyage-embedder.ts; get a key at https://voyageai.com).
# Unset -> createVoyageEmbedderFromEnv() returns null and retrieval is
# skipped gracefully, same as no signed content existing yet. Both need to
# be true before this does anything: a key here, AND at least one
# lpe_content_blocks row approved at /admin/settings/lpe-content-library.
VOYAGE_API_KEY=

# --- Error tracking: Sentry (apps/web) ---
# Optional — unset means Sentry.init() is never called (see
# apps/web/src/sentry.server.config.ts), same opt-in pattern as
# services/ml's SENTRY_DSN. Both vars should be set to the same DSN value:
# the NEXT_PUBLIC_ one reaches the browser bundle, the bare one is read
# server/edge-side. A DSN is not a secret.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional, build-time only (source map upload) — safe to leave unset;
# upload is silently skipped without them, per apps/web/next.config.ts.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Identity verification / KYC (apps/web) ---
# Optional — unset means identity verification degrades gracefully: a NIN/BVN
# request is recorded as `pending` (for ops resolution) rather than clicking
# through to nothing. Onboarding never depends on this. See
# apps/web/src/lib/identity/provider.ts for the adapter registry.
# Currently wired provider: "dojah" (Nigerian NIN/BVN lookup). Set:
#   IDENTITY_PROVIDER=dojah
#   IDENTITY_API_KEY=<Dojah secret key>   (Authorization header)
#   IDENTITY_APP_ID=<Dojah AppId>
# Optionally point at the sandbox host for test credentials:
#   IDENTITY_BASE_URL=https://sandbox.dojah.io   (defaults to https://api.dojah.io)
IDENTITY_PROVIDER=
IDENTITY_API_KEY=
IDENTITY_APP_ID=
IDENTITY_BASE_URL=
