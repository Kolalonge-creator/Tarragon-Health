# services/scanner environment template. Copy to .env for local dev. NEVER commit a real key.

# Shared secret the platform sends as X-Service-Key. Must match SCANNER_SERVICE_KEY in the web app's environment.
# Empty = every /scan call is refused with 503 (never accepted unauthenticated).
SCANNER_SERVICE_KEY=

# development | test | production
ENVIRONMENT=development

# clamd in the same container, loopback only (docker/clamd.conf). Change only for a local clamd on another port.
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
CLAMD_TIMEOUT_SECONDS=60

# Upload cap in bytes (the lab-result buckets' own limit is 10 MB).
SCANNER_MAX_BYTES=10485760
