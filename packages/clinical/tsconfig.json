{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "jest"]
  },
  "include": ["src/**/*.ts", "../../supabase/functions/_shared/clinical/*.ts", "../../supabase/functions/_shared/triage/*.ts", "../../supabase/functions/process-events/triage-ports.ts"]
}
