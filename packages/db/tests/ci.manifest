escalation_auto_assignment_and_reassignment_authority.sql

# --- Added 2026-09-16 ---------------------------------------------------------
# private.auto_assign_escalation() and private.auto_match_internal_specialist()
# only checked clinical_staff.active/doctor_tier -- neither ever consulted
# provider_time_off or provider_availability_rules (both built 2026-08-28 for
# patient-facing appointment slots), so a doctor genuinely on leave with the
# lightest caseload could still be auto-routed a brand-new emergency case.
# These two proofs cover the fix (migration
# 20260916005747_escalation_auto_assignment_respects_availability.sql): on
# leave excludes outright (including dropping alert-owner continuity), merely
# blocked/outside-declared-hours only deprioritises, and zero availability
# rules configured is never penalised (fail open). Each mints its own fresh
# org/doctors/patients.
escalation_auto_assignment_respects_availability.sql
specialist_referral_auto_match_respects_availability.sql

# --- Added 2026-09-14 (second pass) ------------------------------------------
# The Platform Analytics & Audit Console (apps/web .../analytics/) has ~55
# SECURITY DEFINER RPCs individually gated by private.is_analyst(), but only
# one had ever been exercised by any test, and only on the positive path (an
# analyst session gets an answer) -- nothing had ever proven a patient,
# clinician, or anonymous caller is actually refused. Discovers its target
# set live from pg_proc rather than a hardcoded list, so it keeps covering
# the console as it grows. Two independent proofs per function: a structural
# check that its is_analyst()/is_admin() guard precedes any data access in
# the live function body, and a behavioural probe of each function under
# simulated sessions. Found and fixed a real gap in itself while being
# written (a naive "did it raise 42501" check flagged an already-safe
# silent-empty-return function as a false leak) before landing on the
# two-layer design here. public_service_coverage() is the one function with
# no gate at all -- confirmed intentional (state-level service-availability
# flags only, no PHI) -- and its lack of a gate is what proves the
# structural check actually discriminates (sabotage control) rather than
# passing vacuously.
analytics_console_rpc_authorization_gate.sql

