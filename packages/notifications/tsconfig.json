{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node",
      "jest"
    ],
    "paths": {
      "@tarragon/i18n": [
        "../i18n/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "../../apps/web/src/lib/notifications/describe-in-app.ts"
  ]
}
