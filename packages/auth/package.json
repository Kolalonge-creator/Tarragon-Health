  "peerDependencies": {
    "next": "16.3.7",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "19.3.0",
    "eslint": "^9",
    "jest": "^30.4.2",
    "next": "16.3.7",
    "react": "19.3.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
