{
  "name": "@tarragon/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Session, Supabase client and role-map layer shared by apps/web and apps/console. Web session cookies are host-only by design (S01d); nothing in this package may set a cookie domain.",
