    "./supabase/server": "./src/supabase/server.ts",
    "./supabase/client": "./src/supabase/client.ts",
    "./supabase/middleware": "./src/supabase/middleware.ts",
    "./supabase/service-role": "./src/supabase/service-role.ts",
    "./current-profile": "./src/current-profile.ts",
    "./roles": "./src/roles.ts",
    "./console-areas": "./src/console-areas.ts",
    "./redirect": "./src/redirect.ts",
    "./rate-limit": "./src/rate-limit.ts",
    "./auth-error-message": "./src/auth-error-message.ts",
    "./password-policy": "./src/password-policy.ts",
    "./record-login-device": "./src/record-login-device.ts",
    "./credentials": "./src/credentials.ts",
    "./first-issue": "./src/first-issue.ts",
    "./phone": "./src/phone.ts",
    "./breached-password": "./src/breached-password.ts",
    "./password-check": "./src/password-check.ts",
    "./auth-error-key": "./src/auth-error-key.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest"
